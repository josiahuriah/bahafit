# ─── NextAuth / Auth.js ──────────────────────────────────────────────────
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=

# Your canonical domain (no trailing slash). Required in production.
AUTH_URL=https://bahafit.com

# ─── Google OAuth ────────────────────────────────────────────────────────
# Create an OAuth 2.0 "Web application" client at:
#   https://console.cloud.google.com/apis/credentials
# under the bahafitmanagement@gmail.com account.
#
# Authorized JavaScript origins:
#   https://bahafit.com
# Authorized redirect URIs:
#   https://bahafit.com/api/auth/callback/google
#
# Google matches redirect URIs exactly — no wildcards, and www is a
# different origin. If the site also answers on https://www.bahafit.com,
# add that origin and its callback URL too, or redirect www to the apex
# domain before the OAuth flow starts.
#
# The OAuth consent screen must be Published (not "Testing") before users
# outside the test-user list can sign in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Facebook OAuth ──────────────────────────────────────────────────────
# Create app at: https://developers.facebook.com/
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ─── MongoDB ─────────────────────────────────────────────────────────────
# Atlas connection string — includes username, password, and cluster host.
MONGODB_URI=
MONGODB_DB=bahafit

# ─── Sanity CMS ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Server-only token with permission to create assets. Required for community
# photo/video uploads. Never prefix this value with NEXT_PUBLIC_.
SANITY_API_TOKEN=

# ─── Fygaro payment integration ─────────────────────────────────────────
# Server-only. NEVER prefix these with NEXT_PUBLIC_ — they would leak to
# the browser bundle if you do.

# JWT `kid` header. Identifies which key signed the token.
FYGARO_API_KEY=

# HMAC-SHA256 signing key. Treat like a password.
FYGARO_API_SECRET=

# Public URL of the payment button you create in the Fygaro dashboard.
# Looks like: https://www.fygaro.com/en/pb/<uuid>
FYGARO_PAYMENT_BUTTON_URL=

# Optional: separate secret for verifying inbound webhook signatures.
# If unset, FYGARO_API_SECRET is used.
FYGARO_WEBHOOK_SECRET=

# ─── App URLs ───────────────────────────────────────────────────────────
# Used to build success/cancel return URLs sent to Fygaro.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Site gate (coming soon / developer preview) ────────────────────────
# Controls what visitors see before launch. Set this PER ENVIRONMENT in
# Vercel (Project → Settings → Environment Variables):
#
#   coming-soon → every visitor is redirected to the /coming-soon page.
#                 Use this on Production so anyone with the link sees the
#                 marketing page and cannot reach the real site.
#   password    → visitors must enter SITE_GATE_PASSWORD on the /enter page
#                 to unlock the real site. Use this on Preview deployments
#                 (the "developer build") so test users can log in.
#   off         → site is fully live, nothing is gated. Set this on
#                 Production at launch.
#
# If SITE_GATE is left unset it defaults by Vercel environment:
# Production → coming-soon, Preview → password, local dev → off.
SITE_GATE=off

# Password for the /enter page (password mode). Defaults to Fit4it! when
# unset. Share this only with test users on the developer build.
SITE_GATE_PASSWORD=Fit4it!

# The unlock cookie is signed with AUTH_SECRET (set above).

# Legacy flag — still honored for back-compat. COMING_SOON_MODE=true forces
# coming-soon mode everywhere; prefer SITE_GATE instead.
# COMING_SOON_MODE=false
