# ─── NextAuth / Auth.js ──────────────────────────────────────────────────
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=

# Your canonical domain (no trailing slash). Required in production.
AUTH_URL=https://bahafit.com

# ─── Google OAuth ────────────────────────────────────────────────────────
# Create an OAuth 2.0 "Web application" client at:
#   https://console.cloud.google.com/apis/credentials
# under the bahafitmanagement@gmail.com account.
#
# Authorized JavaScript origins:
#   https://bahafit.com
# Authorized redirect URIs:
#   https://bahafit.com/api/auth/callback/google
#
# Google matches redirect URIs exactly — no wildcards, and www is a
# different origin. If the site also answers on https://www.bahafit.com,
# add that origin and its callback URL too, or redirect www to the apex
# domain before the OAuth flow starts.
#
# The OAuth consent screen must be Published (not "Testing") before users
# outside the test-user list can sign in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Facebook OAuth ──────────────────────────────────────────────────────
# Create app at: https://developers.facebook.com/
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ─── MongoDB ─────────────────────────────────────────────────────────────
# Atlas connection string — includes username, password, and cluster host.
MONGODB_URI=
MONGODB_DB=bahafit

# ─── Sanity CMS ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# ─── Fygaro payment integration ─────────────────────────────────────────
# Server-only. NEVER prefix these with NEXT_PUBLIC_ — they would leak to
# the browser bundle if you do.

# JWT `kid` header. Identifies which key signed the token.
FYGARO_API_KEY=

# HMAC-SHA256 signing key. Treat like a password.
FYGARO_API_SECRET=

# Public URL of the payment button you create in the Fygaro dashboard.
# Looks like: https://www.fygaro.com/en/pb/<uuid>
FYGARO_PAYMENT_BUTTON_URL=

# Optional: separate secret for verifying inbound webhook signatures.
# If unset, FYGARO_API_SECRET is used.
FYGARO_WEBHOOK_SECRET=

# ─── App URLs ───────────────────────────────────────────────────────────
# Used to build success/cancel return URLs sent to Fygaro.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Coming Soon mode ───────────────────────────────────────────────────
# When set to "true", every request that isn't from a signed-in admin is
# redirected to /coming-soon. Admin sign-in (/auth/signin) and the NextAuth
# API stay reachable so you can log in to see the real site.
# Flip to "false" (or unset) to launch.
COMING_SOON_MODE=false
